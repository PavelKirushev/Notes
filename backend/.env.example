# Скопируй в .env и замени значения перед запуском
# cp .env.example .env

# ── Сервер ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── База данных ───────────────────────────────────────────────────────────────
DB_HOST=localhost          # postgres — внутри Docker, localhost — локально
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_CONNS=25

# ── Auth ──────────────────────────────────────────────────────────────────────
# ВАЖНО: поменяй JWT_SECRET на длинную случайную строку в продакшне!
# Генерация: openssl rand -base64 32
JWT_SECRET=change-me-in-production-min-32-chars
JWT_TOKEN_TTL=24h
BCRYPT_COST=12

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Получить ключ: aistudio.google.com → Get API Key
GEMINI_API_KEY=your-gemini-api-key-here
